# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Database (SQLite file path, relative to backend/)
DATABASE_PATH=./data/bookleaf.db

# Default password assigned to every seeded author account (dev/demo only)
SEED_AUTHOR_PASSWORD=bookleaf123
SEED_ADMIN_PASSWORD=admin123

# AI (Anthropic). Leave blank to run with AI features gracefully disabled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
